{
  "name": "mirakl-dsh-custom-plugin-manager",
  "version": "1.0.0",
  "private": true,
  "description": "Settings › Custom plugins: lists the custom plugins installed in the profile with their installed version, checks remotely (Git upstream, npm registry, GitHub) for newer versions and installs them on request.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nagi-letaifa/mirakl-dsh-custom-plugin-manager.git"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
